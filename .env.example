# .env.example を .env にコピーして値を入れる（.env は git に入らない。値はチャットに貼らない）
# Threads（Meta のアプリ ➔ ユースケース「Threads API にアクセス」の設定画面）
THREADS_APP_ID=
THREADS_APP_SECRET=
# python3 tools/get_tokens.py threads が書き込む
THREADS_ACCESS_TOKEN=
THREADS_TOKEN_EXPIRES=
# 戻り先URL（アプリに登録したものと1文字も違えない。既定 https://sportsbackstage1.wordpress.com/）
OAUTH_REDIRECT_URI=
# 写真付きの投稿（Instagram 運用会社と同じ値でよい）
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
WORDPRESS_TOKEN=
# 通知
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=363171715
